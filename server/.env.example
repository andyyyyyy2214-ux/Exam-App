# ===================================================
# Anand Exam App - Environment Configuration Template
# ===================================================
# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- Local Development (SQLite, zero-dependency) ---
DATABASE_URL="file:./dev.db"

# --- Production (MySQL, uncomment and configure) ---
# DATABASE_URL="mysql://username:password@localhost:3306/anand_exam_db"

# Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"
